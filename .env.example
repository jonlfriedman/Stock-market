# Copy to .env and fill in. Never commit the real .env.

# --- Finviz Elite ---
# Build a screener with filters (Average Volume "Over 300K" for liquidity,
# plus price range / profitability / exclude-funds filters -- see README) in
# the Finviz Elite UI, change the URL path from /screener to /export/screener,
# and append &auth=<your-token-from-the-Export-API-page>. Paste the full
# resulting URL here. Treat the token like a password -- this file is
# gitignored and must never be committed. Deliberately no Relative Volume
# filter here: it's not time-of-day adjusted, so pre-filtering on it biased
# alerts toward being too late in the morning -- the scanner's own per-minute
# acceleration tracking is what should decide what counts as "unusual" now.
FINVIZ_EXPORT_URL_DISCOVERY=
# Filled in later, once the Watchlist profile is built (see README).
FINVIZ_EXPORT_URL_WATCHLIST=

SCANNER_PROFILE=discovery

# Only needed if scripts/discover_finviz_columns.py shows different header
# text than the defaults (esp. for premarket-specific columns).
# FINVIZ_FIELD_TICKER=Ticker
# FINVIZ_FIELD_PRICE=Price
# FINVIZ_FIELD_VOLUME=Volume
# FINVIZ_FIELD_CHANGE=Change
# FINVIZ_FIELD_RELVOLUME=Relative Volume

MIN_AVG_VOLUME_FLOOR=300000

# --- Schedule ---
SCANNER_TIMEZONE=America/New_York
SCAN_START_TIME=04:00
SCAN_END_TIME=09:30
TRADING_WINDOW_START=07:00
POLL_INTERVAL_SECONDS=60

# --- Rolling buffer / acceleration ---
BUFFER_WINDOW_MINUTES=15
MIN_WARMUP_MINUTES=15
ACCEL_WINDOWS=4

# --- RVOL ---
# Still computed and logged for context (and shown in alert messages), but
# NOT part of the score -- Finviz's own RVOL snapshot isn't time-of-day
# adjusted, so it mechanically climbs through the morning regardless of
# real behavior, which was biasing alerts toward being too late to act on.
RVOL_TIME_BUCKET_MINUTES=5
RVOL_MIN_HISTORY_DAYS=10
RVOL_LOOKBACK_DAYS=20

# --- Scoring (Phase-1: loose on purpose) ---
WEIGHT_ACCELERATION=0.8
WEIGHT_PRICE=0.2
SCORE_THRESHOLD=3.0
# Discard tickers trending down before they're ever scored -- only flat or
# up price action confirms the volume move. 0.0 = require >= 0% change.
MIN_PRICE_CHANGE_PCT=0.0

# --- Alerting (Pushover: pushover.net -> create an Application to get the
# API token, your User Key is on your account's main page) ---
ALERT_COOLDOWN_MINUTES=30
DRY_RUN=true
PUSHOVER_API_TOKEN=
PUSHOVER_USER_KEY=
# -2=lowest, -1=low, 0=normal, 1=high (bypasses quiet hours), 2=emergency (repeats until acked)
PUSHOVER_PRIORITY=0

DATA_DIR=data
