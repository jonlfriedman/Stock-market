# Copy to .env and fill in. Never commit the real .env.

# --- Finviz Elite ---
# Personal Export API auth token from elite.finviz.com -> API -> Screener
# Export. Treat it like a password: this file is gitignored and the token
# must never be pasted into chat, committed, or otherwise shared.
FINVIZ_API_KEY=

# Universe screen filter (use #1: run once before BASELINE_START_TIME to
# define the fixed ticker list for the session). Default is the confirmed
# working filter from the build spec: PFCF under 20, common stocks only,
# average volume over 300K, price $1-$10.
FINVIZ_UNIVERSE_FILTER=fa_pfcf_u20,ind_stocksonly,sh_avgvol_o300,sh_price_1to10
FINVIZ_VIEW=111
FINVIZ_FT=4

SCANNER_PROFILE=discovery
# Only used when SCANNER_PROFILE=watchlist -- bypasses the universe screen
# entirely (not part of the initial build; see README's "Two Scanner
# Profiles"). Comma-separated tickers.
FINVIZ_WATCHLIST_TICKERS=

# Only needed if scripts/discover_finviz_columns.py shows different header
# text than the defaults.
# FINVIZ_FIELD_TICKER=Ticker
# FINVIZ_FIELD_PRICE=Price
# FINVIZ_FIELD_VOLUME=Volume
# FINVIZ_FIELD_CHANGE=Change

# --- Schedule (America/New_York by default) ---
SCANNER_TIMEZONE=America/New_York
UNIVERSE_FETCH_TIME=06:30
BASELINE_START_TIME=06:45
TRIGGER_START_TIME=07:00
SCAN_END_TIME=10:00
POLL_INTERVAL_SECONDS=60

# --- Two-phase trigger logic ---
# TBD from the diagnostic week (see README) -- this is a starting point,
# not a validated number.
TRIGGER_MULTIPLIER=3.0
CONFIRMATION_MINUTES=3

# --- Alerting ---
ALERT_COOLDOWN_MINUTES=30
# Diagnostic-first gate. Leave false for ~1 week to run in log-only mode
# (no SMS) while you validate the trigger logic against real data. Only
# flip to true after that, per the build spec.
LIVE_ALERTING_ENABLED=false
# Extra manual override: even with LIVE_ALERTING_ENABLED=true, DRY_RUN=true
# forces alerts to be logged instead of sent (handy for one-off test runs).
DRY_RUN=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBERS=

# --- Effectiveness tracking ---
EFFECTIVENESS_SNAPSHOT_MINUTES=15

DATA_DIR=data
